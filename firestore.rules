rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /schools/{schoolId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || !resource.data.keys().hasAll(['userId']));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().namaSekolah is string && incoming().namaSekolah.size() <= 150;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && incoming().namaSekolah is string && incoming().namaSekolah.size() <= 150;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /rkasItems/{itemId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || !resource.data.keys().hasAll(['userId']));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().uraianKegiatan is string && incoming().uraianKegiatan.size() <= 250 && incoming().totalAnggaran is number && incoming().totalAnggaran >= 0;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && incoming().uraianKegiatan is string && incoming().uraianKegiatan.size() <= 250;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
