rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /schools/{schoolId} {
      allow read, write: if isSignedIn();
    }

    match /rkasItems/{itemId} {
      allow read, write: if isSignedIn();
    }
  }
}
